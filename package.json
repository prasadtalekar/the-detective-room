{
  "name": "the-detective-room",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && node scripts/check-public-build.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "emulators": "node scripts/firebase.mjs emulators:start --only auth,database,hosting --project demo-detective-room",
    "test:rules": "node scripts/firebase.mjs emulators:exec --only database --project demo-detective-room \"vitest run --config vitest.rules.config.ts\"",
    "test:integration": "playwright test",
    "seed:emulator": "node scripts/seed-emulator.mjs",
    "test:e2e": "node scripts/firebase.mjs emulators:exec --only auth,database --project demo-detective-room \"playwright test\"",
    "format:check": "prettier --check src tests scripts *.ts *.json .github/workflows/validate.yml DEVELOPMENT.md"
  },
  "dependencies": {
    "firebase": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "firebase-tools": "^14.0.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
